# Mistral AI — required for summaries, extraction, and RAG chat
MISTRAL_API_KEY=

# Sarvam AI — required for Hinglish audio and for cloud/Render transcription
SARVAM_API_KEY=

# Optional overrides
MISTRAL_MODEL=ministral-8b-latest
WHISPER_MODEL=small
SARVAM_STT_MODEL=saaras:v4

# Pipeline backends: whisper | sarvam and local | mistral
# Leave unset locally to use Whisper + local ONNX embeddings.
# On Render these default to sarvam + mistral automatically.
# TRANSCRIPTION_BACKEND=whisper
# EMBEDDING_BACKEND=local
# MISTRAL_EMBEDDING_MODEL=mistral-embed

# Daily usage limits. Set a limit to 0 to disable that dimension.
# Limits are tracked per client IP and globally, and reset at 00:00 UTC.
RATE_LIMIT_ENABLED=true
DAILY_JOB_LIMIT_PER_IP=3
DAILY_JOB_LIMIT_GLOBAL=25
DAILY_CHAT_LIMIT_PER_IP=40
DAILY_CHAT_LIMIT_GLOBAL=400

# Trust X-Forwarded-For from the hosting proxy (Render sets this automatically).
# Leave false when running directly on a local machine.
# TRUST_PROXY_HEADERS=true
