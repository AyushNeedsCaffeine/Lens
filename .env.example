# Mistral AI — required for summaries, extraction, and RAG chat
MISTRAL_API_KEY=

# Sarvam AI — required for Hinglish audio and for cloud/Render transcription
SARVAM_API_KEY=

# Optional overrides
MISTRAL_MODEL=ministral-8b-latest
WHISPER_MODEL=small
SARVAM_STT_MODEL=saaras:v4

# Pipeline backends: whisper | sarvam and local | mistral
# Leave unset locally to use Whisper + local ONNX embeddings.
# On Render these default to sarvam + mistral automatically.
# TRANSCRIPTION_BACKEND=whisper
# EMBEDDING_BACKEND=local
# MISTRAL_EMBEDDING_MODEL=mistral-embed
